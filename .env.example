# Supabase — public, client-side keys (safe to expose in the bundle).
# Set the SAME values in your Vercel project settings → Environment Variables,
# then copy this file to `.env` for local development.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Server-only (Vercel functions in api/ and the build's content snapshot).
# Never prefix these with VITE_: that would put them in the browser bundle.
# Put real values in .env.local (gitignored) and in Vercel → Environment Variables.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-token
# Comma-separated emails allowed into /admin (after Supabase sign-in).
ADMIN_EMAILS=you@example.com
# Optional: Vercel deploy hook, called after admin edits so prerendered pages and the sitemap refresh.
VERCEL_DEPLOY_HOOK_URL=
